# 应用配置
# development / test / production
APP_ENV=development
DEFAULT_MODEL_PROFILE=default
LOG_LEVEL=INFO

# SQLite 会话数据库文件；相对路径以启动时工作目录为基准。
SESSION_DB_PATH=.data/sessions.sqlite3

# DeepSeek 使用 OpenAI 兼容接口；SDK 从 OPENAI_API_KEY 读取对应的 DeepSeek Key。
# 本地填写在 .env 中，不要提交密钥。
OPENAI_API_KEY=

# DeepSeek API 地址。
OPENAI_BASE_URL=https://api.deepseek.com

# 可选：仅用于将 SDK trace 导出到 OpenAI；不能填 DeepSeek Key。
OPENAI_TRACING_API_KEY=
